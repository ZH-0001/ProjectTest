# MySQL development database only. Copy to .env.local and fill locally.
DB_URL=jdbc:mysql://127.0.0.1:3306/study_room_app?createDatabaseIfNotExist=true&useUnicode=true&characterEncoding=UTF-8&serverTimezone=Asia/Shanghai
DB_USERNAME=root
DB_PASSWORD=
# Dedicated test database. Tests never run against DB_URL.
DB_TEST_URL=jdbc:mysql://127.0.0.1:3306/study_room_app_test?createDatabaseIfNotExist=true&useUnicode=true&characterEncoding=UTF-8&serverTimezone=Asia/Shanghai
ADMIN_PASSWORD=
# Optional DeepSeek assistant. Keep the key private.
ASSISTANT_ENABLED=false
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com
